{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "editorMode": "vim",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "outputStyle": "Concise",
  "respondToBashCommands": false,
  "statusLine": {
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh",
    "type": "command"
  },
  "theme": "auto"
}