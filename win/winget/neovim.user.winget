##############################################################################
# Neovim
# Installs Neovim, sets it as EDITOR, symlinks the Neovim config and points vim
# at the dotfiles vimrc via $VIMINIT
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

##############################################################################
# Neovim
##############################################################################

- name: Neovim
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Neovim
  properties:
    id: Neovim.Neovim
    source: winget
    installMode: silent

- name: EditorEnvVar
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Ensure Neovim is set as EDITOR
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "EDITOR" -Value "nvim"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "EDITOR" -Value "nvim"

# Neovim has no dedicated config-path variable ($NVIM_APPNAME only renames the
# leaf folder). $XDG_CONFIG_HOME would work, but it is user-wide and every other
# XDG-aware tool would follow it into the repo, so the symlink stays.
- name: NvimSettings
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Ensure Neovim is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LocalAppData\nvim" = "$env:DOTFILES\common\config\nvim"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LocalAppData\nvim" = "$env:DOTFILES\common\config\nvim"
      }
      New-SymlinkConfig -Config $config

# Vim looks at $VIMINIT (a set of Ex commands) before ~/.vimrc, so sourcing the
# dotfiles vimrc from there replaces the symlink. The path is single-quoted
# because Vim treats a backslash in a double-quoted string as an escape.
- name: VimrcSettings
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Ensure vim reads its vimrc from the dotfiles repo
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $vimrc = "$env:DOTFILES\common\config\vim\.vimrc"
      Test-EnvVar -Name "VIMINIT" -Value "let `$MYVIMRC='$vimrc' | source `$MYVIMRC"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $vimrc = "$env:DOTFILES\common\config\vim\.vimrc"
      Add-EnvVar -Name "VIMINIT" -Value "let `$MYVIMRC='$vimrc' | source `$MYVIMRC"
