$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# Fonts
# TODO: Migrate to https://github.com/chocolatey-community/Chocolatey-Module if they support DSC 3
# TODO: Or replace font install with WinGet when they add font support (https://github.com/ryanoasis/nerd-fonts/issues/1935)
##############################################################################

- name: InstallChocolatey
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Chocolatey
  properties:
    id: Chocolatey.Chocolatey
    source: winget

- name: InstallChocolateyModule
  type: Microsoft.DSC.Transitional/RunCommandOnSet
  properties:
    executable: C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
    arguments:
      "0": -NoProfile
      "1": -NoLogo
      "2": -Command
      "3": >-
        if (-not (Get-Module -ListAvailable -Name Chocolatey))
        { Install-Module -Name Chocolatey -Scope AllUsers -Force -AllowClobber }
      treatAsArray: true
  metadata:
    description: Ensure the Chocolatey module is installed from the PowerShell Gallery

- name: NerdFontsBitstreamVeraSansMono
  type: Chocolatey/ChocolateyPackage
  dependsOn:
    - InstallChocolatey
    - InstallChocolateyModule
  metadata:
    description: Install Bitstream Vera Sans Mono Nerd Font using Chocolatey
  properties:
    name: nerd-fonts-bitstreamverasansmono

- name: NerdFontsCommitMono
  type: Chocolatey/ChocolateyPackage
