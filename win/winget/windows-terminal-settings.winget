$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# Windows Terminal settings
##############################################################################

- name: WindowsTerminal
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Microsoft Windows Terminal
  properties:
    id: Microsoft.WindowsTerminal
    source: winget

- name: WindowsTerminalSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Windows Terminal is configured
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:LocalAppData\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json" = "$env:DOTFILES\win\config\WindowsTerminal\settings.json"
      }
      return Get-SymlinkConfigResult -Config $config
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:LocalAppData\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json" = "$env:DOTFILES\win\config\WindowsTerminal\settings.json"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:LocalAppData\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json" = "$env:DOTFILES\win\config\WindowsTerminal\settings.json"
      }
      New-SymlinkConfig -Config $config
