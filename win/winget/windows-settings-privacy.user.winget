##############################################################################
# Privacy
# This configuration disables telemetry, tracking, and other privacy-invasive features in Windows.
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

# Advertising & suggestions
- name: AdvertisingInfo
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable advertising ID for experiences across apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo
    valueName: Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent338393
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content in settings app (338393)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338393Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent338394
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content in settings app (338394)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338394Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent338396
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content in settings app (338396)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338396Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent353694
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content in settings app (353694)
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-353694Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent353696
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content in settings app (353696)
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-353696Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SilentInstalledApps
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable tips and suggestions for welcome and what's new
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SilentInstalledAppsEnabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedApps338388
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable auto installing suggested apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338388Enabled
    valueData:
      DWord: 0
    _exist: true

- name: TipsSuggestions338389
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable tips and suggestions when using Windows
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338389Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SystemPaneSuggestions
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested apps in Settings system pane
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SystemPaneSuggestionsEnabled
    valueData:
      DWord: 0
    _exist: true

- name: SoftLanding
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Soft Landing tutorial/tips notifications for new users
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SoftLandingEnabled
    valueData:
      DWord: 0
    _exist: true

- name: RotatingLockScreenOverlay
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable promotional/rotating lock screen overlay (ads, fun facts)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: RotatingLockScreenOverlayEnabled
    valueData:
      DWord: 0
    _exist: true

- name: DisableLockscreenTips
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable tips, tricks and fun facts on the lock screen (SubscribedContent-338387)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-338387Enabled
    valueData:
      DWord: 0
    _exist: true

- name: PreInstalledApps
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable auto-install of preinstalled promotional apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: PreInstalledAppsEnabled
    valueData:
      DWord: 0
    _exist: true

- name: OemPreInstalledApps
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable auto-install of OEM-bundled bloatware apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: OemPreInstalledAppsEnabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent310093
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content channel 310093 (suggested apps in Settings)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-310093Enabled
    valueData:
      DWord: 0
    _exist: true

- name: SuggestedContent88000326
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable suggested content channel 88000326 (Store app suggestions)
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
    valueName: SubscribedContent-88000326Enabled
    valueData:
      DWord: 0
    _exist: true

- name: StartNoRecommendedTips
  type: Microsoft.Windows/Registry
  metadata:
    description: "Start: Disable Recommended Tips, Shortcuts, New Apps and more"
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Start_IrisRecommendations
    valueData:
      DWord: 0
    _exist: true

- name: DisableSearchSuggestions
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable search box suggestions in Start Menu
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\Explorer
    valueName: DisableSearchBoxSuggestions
    valueData:
      DWord: 1
    _exist: true

- name: DisableBingSearch
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Bing search integration
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Search
    valueName: BingSearchEnabled
    valueData:
      DWord: 0
    _exist: true

- name: CortanaConsent
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Cortana consent
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Search
    valueName: CortanaConsent
    valueData:
      DWord: 0
    _exist: true

# Tracking & data collection
- name: DisableLaunchTracking
  type: Microsoft.Windows/Registry
  metadata:
    description: "Privacy: Let Windows improve Start and search results by tracking app launches"
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Start_TrackProgs
    valueData:
      DWord: 0
    _exist: true

- name: DisableSmartscreenStore
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable SmartScreen Filter for Store Apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost
    valueName: EnableWebContentEvaluation
    valueData:
      DWord: 0
    _exist: true

- name: DisableKeyLogging
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable key logging and transmission to Microsoft
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Input\TIPC
    valueName: Enabled
    valueData:
      DWord: 0
    _exist: true

- name: LanguageOptOut
  type: Microsoft.Windows/Registry
  metadata:
    description: Opt-out from websites accessing language list
  properties:
    keyPath: HKCU\Control Panel\International\User Profile
    valueName: HttpAcceptLanguageOptOut
    valueData:
      DWord: 1
    _exist: true

- name: RestrictTextCollection
  type: Microsoft.Windows/Registry
  metadata:
    description: Restrict implicit text collection
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\InputPersonalization
    valueName: RestrictImplicitTextCollection
    valueData:
      DWord: 1
    _exist: true

- name: RestrictInkCollection
  type: Microsoft.Windows/Registry
  metadata:
    description: Restrict implicit ink collection
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\InputPersonalization
    valueName: RestrictImplicitInkCollection
    valueData:
      DWord: 1
    _exist: true

- name: HarvestContacts
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable harvesting contacts for input personalization
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\InputPersonalization\TrainedDataStore
    valueName: HarvestContacts
    valueData:
      DWord: 0
    _exist: true

- name: PrivacyPolicy
  type: Microsoft.Windows/Registry
  metadata:
    description: Reject personalization privacy policy
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Personalization\Settings
    valueName: AcceptedPrivacyPolicy
    valueData:
      DWord: 0
    _exist: true

- name: OnlineSpeechPrivacy
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable online speech privacy acceptance
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy
    valueName: HasAccepted
    valueData:
      DWord: 0
    _exist: true

- name: NoTrackDocs
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide recently used files in Quick access
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Start_TrackDocs
    valueData:
      DWord: 0
    _exist: true

# App permissions
- name: DenyAccountInfo
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to account info
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\userAccountInformation
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyContacts
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to contacts
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\contacts
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyCalendar
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to calendar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\appointments
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyPhoneCall
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps permission to make phone calls
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\phoneCall
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyCallHistory
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to call history
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\phoneCallHistory
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyAppDiagnostics
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to diagnostics of other apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\appDiagnostics
    valueName: Value
    valueData:
      String: Deny
    _exist: true

- name: DenyLocation
  type: Microsoft.Windows/Registry
  metadata:
    description: Deny apps access to location
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location
    valueName: Value
    valueData:
      String: Deny
    _exist: true

# Telemetry & feedback
- name: NoFeedback
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Windows feedback requests
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Siuf\Rules
    valueName: NumberOfSIUFInPeriod
    valueData:
      DWord: 0
    _exist: true

- name: TailoredExperiences
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable tailored experiences with diagnostic data
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Privacy
    valueName: TailoredExperiencesWithDiagnosticDataEnabled
    valueData:
      DWord: 0
    _exist: true

# Copilot / Recall / Click to Do (adapted from Windows-Privacy-Debloat.ps1)
- name: TurnOffCopilotUser
  type: Microsoft.Windows/Registry
  metadata:
    description: Turn off Windows Copilot (user policy)
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\WindowsCopilot
    valueName: TurnOffWindowsCopilot
    valueData:
      DWord: 1
    _exist: true

- name: HideCopilotButton
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Copilot button from taskbar
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ShowCopilotButton
    valueData:
      DWord: 0
    _exist: true

# Microsoft Store recommended search results (adapted from winutil WPFTweaksDisableStoreSearch)
- name: DisableStoreSearchRecommendations
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Deny access to Store LocalState db (no Store app suggestions in Start search)
  properties:
    testScript: |
      $db = "$env:LOCALAPPDATA\Packages\Microsoft.WindowsStore_8wekyb3d8bbwe\LocalState\store.db"
      if (-not (Test-Path -LiteralPath $db)) { return $true }
      $acl = Get-Acl -LiteralPath $db
      return [bool]($acl.Access | Where-Object {
        $_.IdentityReference.Value -match 'Everyone' -and
        $_.AccessControlType -eq 'Deny' -and
        $_.FileSystemRights -match 'FullControl'
      })
    setScript: |
      $db = "$env:LOCALAPPDATA\Packages\Microsoft.WindowsStore_8wekyb3d8bbwe\LocalState\store.db"
      if (Test-Path -LiteralPath $db) {
        icacls.exe $db /deny Everyone:F
      }
