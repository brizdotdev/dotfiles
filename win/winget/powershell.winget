$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# PowerShell
##############################################################################

- name: PowerShell
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Microsoft PowerShell
  properties:
    id: Microsoft.WindowsPowerShell
    source: winget

- name: PowerShellTelemetry
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Disable PowerShell telemetry
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Get-EnvVar -Name "POWERSHELL_TELEMETRY_OPTOUT"
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Test-EnvVar -Name "POWERSHELL_TELEMETRY_OPTOUT" -Value "true"
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Add-EnvVar -Name "POWERSHELL_TELEMETRY_OPTOUT" -Value "true"

- name: PowerShellUpdateCheck
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Disable PowerShell update check
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Get-EnvVar -Name "POWERSHELL_UPDATECHECK"
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Test-EnvVar -Name "POWERSHELL_UPDATECHECK" -Value "false"
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Add-EnvVar -Name "POWERSHELL_UPDATECHECK" -Value "false"

- name: PowerShellSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure PowerShell is configured
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$PROFILE.CurrentUserAllHosts" = "$env:DOTFILES\win\config\PowerShell\profile.ps1"
      }
      return Get-SymlinkConfigResult -Config $config
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$PROFILE.CurrentUserAllHosts" = "$env:DOTFILES\win\config\PowerShell\profile.ps1"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$PROFILE.CurrentUserAllHosts" = "$env:DOTFILES\win\config\PowerShell\profile.ps1"
      }
      New-SymlinkConfig -Config $config

- name: PagerLess
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Less is set as the default pager
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Get-EnvVar -Name "PAGER" -Value "less"
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Test-EnvVar -Name "PAGER" -Value "less"
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      Add-EnvVar -Name "PAGER" -Value "less"
