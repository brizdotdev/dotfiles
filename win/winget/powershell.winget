$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# PowerShell
##############################################################################

- name: Terminal
  type: Microsoft.WinGet/Package
  properties:
    id: Microsoft.WindowsTerminal
    source: winget
    installMode: silent
  metadata:
    description: Install Windows Terminal
    winget:
      securityContext: elevated

- name: PowerShell
  type: Microsoft.WinGet/Package
  properties:
    id: Microsoft.PowerShell
    source: winget
    installMode: silent
  metadata:
    description: Install PowerShell 7
    winget:
      securityContext: elevated

- name: Starship
  type: Microsoft.WinGet/Package
  properties:
    id: Starship.Starship
    source: winget
    installMode: silent
  metadata:
    description: Install Starship
    winget:
      securityContext: elevated

- name: Zoxide
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Zoxide
  properties:
    id: ajeetdsouza.zoxide
    source: winget
    installMode: silent

- name: Eza
  type: Microsoft.WinGet/Package
  metadata:
    description: Install eza
  properties:
    id: eza-community.eza
    source: winget
    installMode: silent

- name: ChangeScreenResolutionModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the ChangeScreenResolution module is installed from the PowerShell Gallery
  properties:
    getScript: |
      $module = Get-InstalledPSResource -Name ChangeScreenResolution -ErrorAction SilentlyContinue
      $version = if ($module) { $module.Version.ToString() } else { $null }
      return @{ installed = [bool]$module; version = $version }
    testScript: |
      $module = Get-InstalledPSResource -Name ChangeScreenResolution -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name ChangeScreenResolution `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

