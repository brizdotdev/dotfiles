$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
- name: Discord
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Discord
  properties:
    id: Discord.Discord
    source: winget
    useLatest: true

- name: DiscordStartup
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
  - Discord
  metadata:
    description: Ensure Discord does not start on login
  properties:
    getScript: |
      $val = Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'Discord' -ErrorAction SilentlyContinue
      return @{ Result = ($null -eq $val) }
    testScript: |
      $val = Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'Discord' -ErrorAction SilentlyContinue
      return $null -eq $val
    setScript: |
      Remove-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'Discord' -ErrorAction SilentlyContinue

- name: TinyNvidiaUpdateChecker
  type: Microsoft.WinGet/Package
  metadata:
    description: Install TinyNvidiaUpdateChecker
  properties:
    id: Hawaii_Beach.TinyNvidiaUpdateChecker
    source: winget
    useLatest: true

- name: Steam
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Steam
  properties:
    id: Valve.Steam
    source: winget
    useLatest: true

- name: GOGGalaxy
  type: Microsoft.WinGet/Package
  metadata:
    description: Install GOG Galaxy
  properties:
    id: GOG.Galaxy
    source: winget
    useLatest: true
