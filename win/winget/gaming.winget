$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
- name: Discord
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Discord
  properties:
    id: Discord.Discord
    source: winget
    installMode: silent

- name: DiscordStartup
  type: Microsoft.Windows/Registry
  dependsOn:
  - Discord
  metadata:
    description: Ensure Discord does not start on login
    winget:
      securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows\CurrentVersion\Run
    valueName: Discord
    _exist: false

- name: TinyNvidiaUpdateChecker
  type: Microsoft.WinGet/Package
  metadata:
    description: Install TinyNvidiaUpdateChecker
  properties:
    id: Hawaii_Beach.TinyNvidiaUpdateChecker
    source: winget
    installMode: silent

- name: Steam
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Steam
  properties:
    id: Valve.Steam
    source: winget
    installMode: silent

- name: GOGGalaxy
  type: Microsoft.WinGet/Package
  metadata:
    description: Install GOG Galaxy
  properties:
    id: GOG.Galaxy
    source: winget
    installMode: silent
