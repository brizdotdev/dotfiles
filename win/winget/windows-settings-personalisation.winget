    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Windows\Explorer
    valueName: HideCategoryView
    valueData:
      DWord: 1
    _exist: true

# Only honored on builds >= 26300 (25H2 Insider); inert on earlier builds
