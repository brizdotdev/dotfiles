$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: DeveloperMode
  type: Microsoft.Windows/Registry
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
    valueName: AllowDevelopmentWithoutDevLicense
    valueData:
      DWord: 1
  metadata:
    description: Enable Developer Mode (sideload + dev features)
    securityContext: elevated

- name: HostsEnvVar
  type: OpenDsc.Windows/Environment
  metadata:
    description: Set an environment variable to hosts file
  properties:
    name: HOSTS
    value: C:\Windows\System32\drivers\etc\hosts
    scope: User

##############################################################################
# Languages
##############################################################################

- name: Bun
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Bun
  properties:
    id: oven-sh.bun
    source: winget
    useLatest: true

- name: UV
  type: Microsoft.WinGet/Package
  metadata:
