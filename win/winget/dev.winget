- name: WindowsSandbox
  type: Microsoft.Windows/OptionalFeatureList
  metadata:
    description: Enable Windows Sandbox
    securityContext: elevated
  properties:
    features:
      - featureName: Containers-DisposableClientVM
        state: Installed

- type: Microsoft.DSC.Transitional/RunCommandOnSet
  name: Microsoft.WindowsSandbox.DSC.Module
  properties:
    executable: C:\Program Files\PowerShell\7\pwsh.exe
    arguments:
      "0": -NoProfile
      "1": -NoLogo
      "2": -Command
      "3": >-
        if (-not (Get-Module -ListAvailable -Name Microsoft.WindowsSandbox.DSC))
        { Install-PSResource -Name Microsoft.WindowsSandbox.DSC -Prerelease
        -TrustRepository -AcceptLicense }
      treatAsArray: true
  metadata:
    description: Ensure Microsoft.WindowsSandbox.DSC module is installed

- type: Microsoft.WindowsSandbox.DSC/WindowsSandbox
  name: WindowsSandbox
  dependsOn:
    - Microsoft.WindowsSandbox.DSC.Module
  properties:
    Ensure: Present
    #WsbFile: <Provide a custom .wsb file to open. The parameters below will override existing values in the wsb file>
    LogonCommand: >
      cmd /c start powershell -NoExit -Command "$progressPreference = 'silentlyContinue';
      Write-Host 'Setting execution policy to remote signed...' `n;
      Set-ExecutionPolicy RemoteSigned -Force;
      Write-Host 'Installing WinGet PowerShell module from PSGallery...';
      Install-PackageProvider -Name NuGet -Force | Out-Null;
      Install-Module -Name Microsoft.WinGet.Client -Force -Repository PSGallery | Out-Null;
      Write-Host 'Using Repair-WinGetPackageManager cmdlet to bootstrap WinGet...';
      Repair-WinGetPackageManager;
      Write-Host 'Done.';
    #HostFolder: <Absolute path to folder on host machine that will be shared into the Windows Sandbox>
    #SandboxFolder: <Absolute path to destination in the sandbox to map the Host Folder to>
    #ReadOnly: false
    #MemoryInMB: 2048
    #vGPU: true
    #AudioInput: true
    #ClipboardRedirection: true
    #Networking: true
    #PrinterRedirection: false
    #ProtectedClient: false
    #VideoInput: true
  metadata:
    description: Create Windows Sandbox with Winget installed

##############################################################################
# Git
##############################################################################

- name: MiseConfigSymlink
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Symlink mise config.toml to dotfiles
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      New-SymlinkConfig -Config $config

##############################################################################
# Utils
##############################################################################

- name: Poppler
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Poppler (Yazi PDF Preview)
  properties:
    id: oschwartz10612.poppler
    source: winget
    installMode: silent

- name: mise
  type: Microsoft.WinGet/Package
  metadata:
    description: Install mise
  properties:
    id: jdx.mise
    source: winget
    installMode: silent

- name: MiseShimsPath
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the mise shims directory is in the PATH
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      return Test-EnvPath -Paths @($shimsPath)
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      Add-EnvPath -Paths @($shimsPath)
