##############################################################################
# Git
##############################################################################

- name: Delta
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Delta
  properties:
    id: dandavison.delta
    source: winget
    useLatest: true

- name: GitConfig
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Git is configured
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.gitconfig" = "$env:DOTFILES\common\config\git\.gitconfig"
        "$env:USERPROFILE\.gitignore_global" = "$env:DOTFILES\common\config\git\.gitignore_global"
      }
      return Get-SymlinkConfigResult -Config $config
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.gitconfig" = "$env:DOTFILES\common\config\git\.gitconfig"
        "$env:USERPROFILE\.gitignore_global" = "$env:DOTFILES\common\config\git\.gitignore_global"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.gitconfig" = "$env:DOTFILES\common\config\git\.gitconfig"
        "$env:USERPROFILE\.gitignore_global" = "$env:DOTFILES\common\config\git\.gitignore_global"
      }
      New-SymlinkConfig -Config $config

