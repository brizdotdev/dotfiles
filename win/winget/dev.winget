##############################################################################
# Development
# Developer environment: language runtimes/SDKs, WSL, containers, Git config,
# and CLI utilities
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: HostsEnvVar
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Set an environment variable to hosts file
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "HOSTS" -Value "C:\Windows\System32\drivers\etc\hosts"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "HOSTS" -Value "C:\Windows\System32\drivers\etc\hosts"

##############################################################################
# Languages
##############################################################################

- name: RemoveFakePython
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Microsoft Store Python app is uninstalled and removed from the PATH
  properties:
    testScript: |
      $pythonExecutables = Get-ChildItem -Path "$env:LocalAppData\Microsoft\WindowsApps\*python*.exe" -ErrorAction SilentlyContinue
      return $pythonExecutables.Count -eq 0
    setScript: |
      Get-ChildItem -Path "$env:LocalAppData\Microsoft\WindowsApps\*python*.exe" -ErrorAction SilentlyContinue | ForEach-Object {
        Remove-Item -Path $_.FullName -Force
      }

##############################################################################
# WSL
##############################################################################

- name: WSL
  type: Microsoft.WinGet/Package
  metadata:
    description: Install WSL
    securityContext: elevated
  properties:
    id: Microsoft.WSL
    source: winget
    installMode: silent

- name: InstallWslComponents
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  properties:
    testScript: |
      # If vmcompute is present, VMP is active — components already installed.
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return [bool]$svc
    setScript: |
      Write-Host "InstallWslComponents: running wsl --install --no-distribution..."
      # Launch wsl.exe directly WITHOUT -NoNewWindow and WITHOUT -RedirectStandard*
      # so Start-Process allocates a fresh console (CREATE_NEW_CONSOLE), which
      # wsl's install bootstrap requires. The dscv3 host has no console to
      # inherit, so -NoNewWindow (or -RedirectStandardOutput, which also
      # suppresses the new console) makes wsl fail with "The Windows Subsystem
      # for Linux is not installed". With no -Redirect* flags PowerShell never
      # captures wsl's output — it goes to that console, not PowerShell's error
      # stream — so there is no stderr-as-error problem and no cmd ">nul" needed.
      $p = Start-Process -FilePath 'wsl.exe' -ArgumentList '--install','--no-distribution' -Wait -PassThru
      if ($p.ExitCode -eq 3010 -or $p.ExitCode -eq 1641) {
        $p = Start-Process -FilePath 'wsl.exe' -ArgumentList '--update','--pre-release' -Wait -PassThru
        Write-Host "WSL installed successfully, but a system reboot is required."
      }
      elseif ($p.ExitCode -ne 0) {
        throw "InstallWslComponents: wsl --install failed with exit code $($p.ExitCode)"
      }
  metadata:
    securityContext: elevated


##############################################################################
# Containers
##############################################################################

# TODO: Replace with wslc when that's available (https://learn.microsoft.com/en-us/windows/wsl/wsl-container)
- name: DockerDesktop
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Docker Desktop
  properties:
    id: Docker.DockerDesktop
    source: winget
    installMode: silent

- name: DockerSandbox
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Docker Sandbox
  properties:
    id: Docker.sbx
    source: winget
    installMode: silent

- name: WindowsSandbox
  type: Microsoft.Windows/WindowsFeatureList
  metadata:
    description: Enable Windows Sandbox
    securityContext: elevated
  properties:
    features:
      - featureName: Containers-DisposableClientVM
        state: Installed

##############################################################################
# Git
##############################################################################

- name: GitConfig
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Git is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.gitconfig" = "$env:DOTFILES\common\config\git\.gitconfig"
        "$env:USERPROFILE\.gitignore_global" = "$env:DOTFILES\common\config\git\.gitignore_global"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.gitconfig" = "$env:DOTFILES\common\config\git\.gitconfig"
        "$env:USERPROFILE\.gitignore_global" = "$env:DOTFILES\common\config\git\.gitignore_global"
      }
      New-SymlinkConfig -Config $config

- name: MiseConfigSymlink
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Symlink mise config.toml to dotfiles
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      New-SymlinkConfig -Config $config

##############################################################################
# Utils
##############################################################################

# https://opencode.ai/docs/tools#websearch
- name: OpenCodeExa
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Enable websearch tool for OpenCode
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "OPENCODE_ENABLE_EXA" -Value "1"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "OPENCODE_ENABLE_EXA" -Value "1"

- name: LazygitSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Lazygit is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LOCALAPPDATA\lazygit\config.yml" = "$env:DOTFILES\common\config\lazygit\config.yml"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LOCALAPPDATA\lazygit\config.yml" = "$env:DOTFILES\common\config\lazygit\config.yml"
      }
      New-SymlinkConfig -Config $config

- name: Poppler
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Poppler (Yazi PDF Preview)
  properties:
    id: oschwartz10612.poppler
    source: winget
    installMode: silent

- name: mise
  type: Microsoft.WinGet/Package
  metadata:
    description: Install mise
  properties:
    id: jdx.mise
    source: winget
    installMode: silent

- name: MiseShimsPath
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the mise shims directory is in the PATH
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      return Test-EnvPath -Paths @($shimsPath)
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      Add-EnvPath -Paths @($shimsPath)
