$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
- name: OneDriveAbsent
  type: Microsoft.WinGet/Package
  metadata:
    description: Uninstall OneDrive
  properties:
    id: Microsoft.OneDrive
    source: winget
    _exist: false

- name: TeamsAbsent
  type: Microsoft.WinGet/Package
  metadata:
    description: Uninstall Microsoft Teams
  properties:
    id: Microsoft.Teams
    source: winget
    _exist: false

- name: TeamsStoreAbsent
  type: Microsoft.WinGet/Package
  metadata:
    description: Uninstall Microsoft Teams (store version)
  properties:
    id: XP8BT8DW290MPQ
    source: msstore
    _exist: false
