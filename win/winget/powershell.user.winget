##############################################################################
# PowerShell & shell
# Installs PowerShell 7, shell tools (Starship, zoxide, eza) and PowerShell
# modules, sets shell environment variables, and symlinks profile configs
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: Zoxide
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Zoxide
  properties:
    id: ajeetdsouza.zoxide
    source: winget
    installMode: silent

- name: Eza
  type: Microsoft.WinGet/Package
  metadata:
    description: Install eza
  properties:
    id: eza-community.eza
    source: winget
    installMode: silent

- name: ChangeScreenResolutionModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the ChangeScreenResolution module is installed from the PowerShell Gallery
  properties:
    testScript: |
      $module = Get-InstalledPSResource -Name ChangeScreenResolution -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name ChangeScreenResolution `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

- name: PoshGitModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the posh-git module is installed from the PowerShell Gallery
  properties:
    testScript: |
      $module = Get-InstalledPSResource -Name posh-git -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name posh-git `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

- name: DockerCompletionModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the DockerCompletion module is installed from the PowerShell Gallery
  properties:
    testScript: |
      $module = Get-InstalledPSResource -Name DockerCompletion -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name DockerCompletion `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

- name: CompletionPredictorModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the CompletionPredictor module is installed from the PowerShell Gallery
  properties:
    testScript: |
      $module = Get-InstalledPSResource -Name CompletionPredictor -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name CompletionPredictor `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

- name: PSFzfModule
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure the PSFzf module is installed from the PowerShell Gallery
  properties:
    testScript: |
      $module = Get-InstalledPSResource -Name PSFzf -ErrorAction SilentlyContinue
      return [bool]$module
    setScript: |
      Install-PSResource -Name PSFzf `
        -Repository PSGallery `
        -TrustRepository `
        -AcceptLicense `
        -Scope CurrentUser

- name: PowerShellTelemetry
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Disable PowerShell telemetry
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "POWERSHELL_TELEMETRY_OPTOUT" -Value "true"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "POWERSHELL_TELEMETRY_OPTOUT" -Value "true"

- name: PowerShellUpdateCheck
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Disable PowerShell update check
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "POWERSHELL_UPDATECHECK" -Value "false"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "POWERSHELL_UPDATECHECK" -Value "false"

- name: PowerShellSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure PowerShell is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $profileAllHosts = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\profile.ps1'
      $config = @{
        $profileAllHosts = "${WinGetConfigRoot}\..\config\PowerShell\profile.ps1"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $profileAllHosts = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\profile.ps1'
      $config = @{
        $profileAllHosts = "${WinGetConfigRoot}\..\config\PowerShell\profile.ps1"
      }
      New-SymlinkConfig -Config $config

- name: StarshipSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Starship is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $starshipConfig = Join-Path ([Environment]::GetFolderPath('UserProfile')) '.config\starship.toml'
      $config = @{
        $starshipConfig = "${WinGetConfigRoot}\..\..\common\config\starship\starship.toml"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $starshipConfig = Join-Path ([Environment]::GetFolderPath('UserProfile')) '.config\starship.toml'
      $config = @{
        $starshipConfig = "${WinGetConfigRoot}\..\..\common\config\starship\starship.toml"
      }
      New-SymlinkConfig -Config $config

- name: SetLessAsPager
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Less is set as the default pager
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "PAGER" -Value "less"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "PAGER" -Value "less"
