$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
- name: WindowsSettings
  type: Microsoft.Windows.Settings/WindowsSettings
  metadata:
    description: Configure Windows
  properties:
    AppColorMode: "Dark"
    SystemColorMode: "Dark"
    TaskbarAlignment: "Middle"

- name: PowerSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Disable hibernation, disable sleep, set display timeout, and disable sleep on lid close
    winget:
      securityContext: elevated
  properties:
    getScript: |
      return @{ Result = @{
      LidClose = (powercfg /query SCHEME_CURRENT 4f971e89-eebd-4455-a8de-9e59040e7347 5ca83367-6e45-459f-a27b-476b1d01c936)
      SleepTimeout = (powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE)
      MonitorTimeout = (powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE)
      } }
    testScript: |
      return $false
    setScript: |
      powercfg /hibernate off
      powercfg /change standby-timeout-ac 0
      powercfg /change standby-timeout-dc 0
      powercfg /change monitor-timeout-ac 5
      powercfg /change monitor-timeout-dc 5
      powercfg -setacvalueindex SCHEME_CURRENT 4f971e89-eebd-4455-a8de-9e59040e7347 5ca83367-6e45-459f-a27b-476b1d01c936 0
      powercfg -setdcvalueindex SCHEME_CURRENT 4f971e89-eebd-4455-a8de-9e59040e7347 5ca83367-6e45-459f-a27b-476b1d01c936 0

- name: AdvertisingInfo
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable advertising ID for experiences across apps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo
    valueName: Enabled
    valueData:
      DWord: 0
    _exist: true

- name: DisableLaunchTracking
