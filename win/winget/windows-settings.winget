##############################################################################
# Settings
# Windows general settings and options
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: DeveloperMode
  type: Microsoft.Windows/Registry
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
    valueName: AllowDevelopmentWithoutDevLicense
    valueData:
      DWord: 1
  metadata:
    description: Enable Developer Mode (sideload + dev features)
    securityContext: elevated

- name: AdvancedSettings
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Advanced Settings
  properties:
    id: 9N8MHTPHNGVV
    source: msstore
    installMode: silent
    acceptAgreements: true

# File Explorer
- name: ExplorerLaunchTo
  type: Microsoft.Windows/Registry
  metadata:
    description: Open File Explorer to This PC
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: LaunchTo
    valueData:
      DWord: 1
    _exist: true

- type: Microsoft.Windows/Registry
  name: FullPathTitlebar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: FullPathAddress
    valueData:
      DWord: 1
  metadata:
    description: Show full path in Explorer titlebar
    securityContext: elevated

- name: ShowSuperHidden
  type: Microsoft.Windows/Registry
  metadata:
    description: Show system (super hidden) files in Explorer
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ShowSuperHidden
    valueData:
      DWord: 1
    _exist: true

- name: ShowHiddenFiles
  type: Microsoft.Windows/Registry
  metadata:
    description: Show hidden files in Explorer
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Hidden
    valueData:
      DWord: 1
    _exist: true

- name: ShowFileExt
  type: Microsoft.Windows/Registry
  metadata:
    description: Show file extensions in Explorer
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: HideFileExt
    valueData:
      DWord: 0
    _exist: true

- name: FullPathTitle
  type: Microsoft.Windows/Registry
  metadata:
    description: Show full path in Explorer title bar
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\CabinetState
    valueName: FullPath
    valueData:
      DWord: 1
    _exist: true

- name: NoThumbsdbNetwork
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Thumbs.db on network folders
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer
    valueName: DisableThumbnailsOnNetworkFolders
    valueData:
      DWord: 1
    _exist: true

- name: HideOfficeFiles
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide files from office.com
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer
    valueName: ShowCloudFilesInQuickAccess
    valueData:
      DWord: 0
    _exist: true

- name: HideGallery
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Gallery from Explorer
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ShowGallery
    valueData:
      DWord: 0
    _exist: true

- name: HideGallery2
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Gallery from Explorer
  properties:
    keyPath: HKCU\Software\Classes\CLSID\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c}
    valueName: System.IsPinnedToNameSpaceTree
    valueData:
      DWord: 0
    _exist: true

- name: HideOneDriveExplorer
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide OneDrive from Explorer navigation pane
  properties:
    keyPath: HKCU\Software\Classes\CLSID\{018D5C66-4533-4307-9B53-224DE2ED1FE6}
    valueName: System.IsPinnedToNameSpaceTree
    valueData:
      DWord: 0
    _exist: true

- name: NoShowFrequent
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide frequent folders in Quick access
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer
    valueName: ShowFrequent
    valueData:
      DWord: 0
    _exist: true

- name: ShowLnkExtension
  type: Microsoft.Windows/Registry
  metadata:
    description: Show .lnk file extension on shortcut files
    securityContext: elevated
  properties:
    keyPath: HKEY_CLASSES_ROOT\lnkfile
    valueName: NeverShowExt
    _exist: false

- name: DisableAutoplay
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable AutoPlay for removable media
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers
    valueName: DisableAutoplay
    valueData:
      DWord: 1
    _exist: true

- name: DisableAutorunAllDrives
  type: Microsoft.Windows/Registry
  metadata:
    description: Block autorun on all drive types (policy)
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer
    valueName: NoDriveTypeAutoRun
    valueData:
      DWord: 255
    _exist: true

# Add common folders back to 'This PC' (adapted from Win11Debloat Add_All_Folders_Under_This_PC.reg)
- name: AddFoldersToThisPC
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Add Desktop, Documents, Downloads, Music, Pictures and Videos folders back to 'This PC' in File Explorer
    securityContext: elevated
  properties:
    testScript: |
      $guids = @(
        '{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}',
        '{d3162b92-9365-467a-956b-92703aca08af}',
        '{088e3905-0323-4b02-9826-5d99428e115f}',
        '{3dfdf296-dbec-4fb4-81d1-6a3438bcf4de}',
        '{1CF1260C-4DD0-4ebb-811F-33C572699FDE}',
        '{24ad3ad4-a569-4530-98e1-ab02f9417aa8}',
        '{f86fa3ab-70d2-4fc7-9c99-fcbf05467f3a}'
      )
      $base = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\MyComputer\NameSpace'
      foreach ($guid in $guids) {
        $path = Join-Path $base $guid
        if (-not (Test-Path -LiteralPath $path)) { return $false }
        $hideIfEnabled = (Get-ItemProperty -LiteralPath $path -Name HideIfEnabled -ErrorAction SilentlyContinue).HideIfEnabled
        if ($null -ne $hideIfEnabled) { return $false }
        $hiddenByDefault = (Get-ItemProperty -LiteralPath $path -Name HiddenByDefault -ErrorAction SilentlyContinue).HiddenByDefault
        if ($hiddenByDefault -ne 0) { return $false }
      }
      return $true
    setScript: |
      $guids = @(
        '{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}',
        '{d3162b92-9365-467a-956b-92703aca08af}',
        '{088e3905-0323-4b02-9826-5d99428e115f}',
        '{3dfdf296-dbec-4fb4-81d1-6a3438bcf4de}',
        '{1CF1260C-4DD0-4ebb-811F-33C572699FDE}',
        '{24ad3ad4-a569-4530-98e1-ab02f9417aa8}',
        '{f86fa3ab-70d2-4fc7-9c99-fcbf05467f3a}'
      )
      $base = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\MyComputer\NameSpace'
      foreach ($guid in $guids) {
        $path = Join-Path $base $guid
        if (-not (Test-Path -LiteralPath $path)) {
          New-Item -Path $path -Force | Out-Null
        }
        Remove-ItemProperty -LiteralPath $path -Name HideIfEnabled -ErrorAction SilentlyContinue
        Set-ItemProperty -LiteralPath $path -Name HiddenByDefault -Value 0 -Type DWord
      }

# Windows Update
- name: NoAutoRestart
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic restart after updates
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate
    valueName: SetActiveHours
    valueData:
      DWord: 0
    _exist: true

- name: AuOptions
  type: Microsoft.Windows/Registry
  metadata:
    description: Set AU to auto-download but notify before installing
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
    valueName: AUOptions
    valueData:
      DWord: 4
    _exist: true

- name: NoAutoRebootLoggedOn
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic reboot when users are logged on
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
    valueName: NoAutoRebootWithLoggedOnUsers
    valueData:
      DWord: 1
    _exist: true

- name: NoExpeditedReboot
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic reboot after update install
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: IsExpedited
    valueData:
      DWord: 0
    _exist: true

- name: NoRestartNotifications
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable restart required notifications
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: RestartNotificationsAllowed2
    valueData:
      DWord: 0
    _exist: true

- name: NoMeteredUpdates
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable auto updates over metered connections
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: AllowAutoWindowsUpdateDownloadOverMeteredNetwork
    valueData:
      DWord: 0
    _exist: true

- name: ReceiveOtherMicrosoftUpdates
  type: Microsoft.Windows/Registry
  metadata:
    description: Receive updates for other Microsoft products (Office, Visual Studio, etc.)
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: AllowMUUpdateService
    valueData:
      DWord: 1
    _exist: true

- name: RegisterMicrosoftUpdateService
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Opt-in to Microsoft Update service via WUA COM API (registers service so AllowMUUpdateService toggle takes effect)
    securityContext: elevated
  properties:
    testScript: |
      try {
        $manager = New-Object -ComObject Microsoft.Update.ServiceManager
        $service = $manager.Services | Where-Object { $_.ServiceID -eq '7971f918-a847-4430-9279-4a52d1efe18d' }
        return ($null -ne $service)
      } catch {
        return $false
      }
    setScript: |
      $manager = New-Object -ComObject Microsoft.Update.ServiceManager
      $manager.ClientApplicationID = 'opencode-dotfiles'
      $null = $manager.AddService2('7971f918-a847-4430-9279-4a52d1efe18d', 7, '')

