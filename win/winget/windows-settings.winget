      DWord: 1
    _exist: true

- name: StartVisiblePlaces
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Hide recommended places in Start Menu
  properties:
    getScript: |
      $val = (Get-ItemProperty -Path 'Registry::HKCU\Software\Microsoft\Windows\CurrentVersion\Start' -Name 'VisiblePlaces' -ErrorAction SilentlyContinue).VisiblePlaces
      return @{ Result = [Convert]::ToBase64String($val) }
    testScript: |
      $val = (Get-ItemProperty -Path 'Registry::HKCU\Software\Microsoft\Windows\CurrentVersion\Start' -Name 'VisiblePlaces' -ErrorAction SilentlyContinue).VisiblePlaces
      return ($null -ne $val -and $val.Length -eq 0)
    setScript: |
      Set-ItemProperty -Path 'Registry::HKCU\Software\Microsoft\Windows\CurrentVersion\Start' -Name 'VisiblePlaces' -Value ([byte[]](,)) -Type Binary -Force

