  ##############################################################################
  # Cursor settings
  ##############################################################################

  - resource: xPSDesiredStateConfiguration/xScript
    id: install-bibata-cursor
    directives:
      description: Install Bibata cursor
      securityContext: elevated
    settings:
      GetScript: |
        return $false
      TestScript: |
          if (Get-ChildItem -Path "$env:WINDIR\Cursors" -Directory -Filter "Bibata*" -ErrorAction SilentlyContinue | Select-Object -First 1) {
            return $true
          }
          return $false
      SetScript: |
        cd "$env:TEMP"
        curl.exe -L -O https://github.com/ful1e5/Bibata_Cursor/releases/download/v2.0.6/Bibata-Modern-Classic-Windows.zip
        if (Test-Path -Path Bibata) {
          Remove-Item -Path Bibata -Force -Recurse
        }
        New-Item -Path .\Bibata -ItemType Directory -Force
        Expand-Archive -Path Bibata-Modern-Classic-Windows.zip -DestinationPath .\Bibata
        $cursors = Get-ChildItem -Path .\Bibata
        foreach ($cursor in $cursors) {
          $installPath = Join-Path -Path $cursor.FullName -ChildPath "install.inf"
          Start-Process "$installPath" -Verb "Install"
        }

  # https://devblogs.microsoft.com/scripting/use-powershell-to-change-the-mouse-pointer-scheme/
  # https://superuser.com/a/1769211
  - resource: xPSDesiredStateConfiguration/xRegistry
    id: reg-set-bibata-cursor-scheme-name
    dependsOn:
      - install-bibata-cursor
    directives:
      description: Set Bibata cursor scheme name (default value)
    settings:
      Key: HKCU:\Control Panel\Cursors
      ValueName: ""
      ValueData: Bibata-Modern-Classic-Small Cursors
      ValueType: String
      Force: True

  - resource: xPSDesiredStateConfiguration/xRegistry
