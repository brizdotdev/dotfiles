  metadata:
    description: Disable enhanced pointer precision (MouseThreshold2)
  properties:
    keyPath: HKCU\Control Panel\Mouse
    valueName: MouseThreshold2
    valueData:
      String: 0
    _exist: true

- name: TaskbarEndTask
  type: Microsoft.Windows/Registry
  metadata:
    description: Show End Task button in taskbar context menu
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings
    valueName: TaskbarEndTask
    valueData:
      DWord: 1
    _exist: true

- name: DisableStickyKeys
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Sticky Keys prompt
  properties:
    keyPath: HKCU\Control Panel\Accessibility\StickyKeys
    valueName: Flags
    valueData:
      String: 10
    _exist: true

- name: AnimateWindows
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable window animations when minimizing and maximizing
  properties:
    keyPath: HKCU\Control Panel\Desktop\WindowMetrics
    valueName: MinAnimate
    valueData:
      String: 0
    _exist: true

- name: DisableAltTabTabs
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable showing tabs in Alt+Tab
  properties:
