  # Refresh cursor after all registry values are set
  # https://superuser.com/a/1769211
  - resource: xPSDesiredStateConfiguration/xScript
    id: script-refresh-cursor
    dependsOn:
      - reg-set-bibata-cursor-scheme-name
      - reg-set-bibata-cursor-scheme-source
      - reg-set-bibata-cursor-base-size
      - reg-set-bibata-cursor-contact-visualization
      - reg-set-bibata-cursor-gesture-visualization
      - reg-set-bibata-cursor-app-starting
      - reg-set-bibata-cursor-arrow
      - reg-set-bibata-cursor-crosshair
      - reg-set-bibata-cursor-hand
      - reg-set-bibata-cursor-help
      - reg-set-bibata-cursor-ibeam
      - reg-set-bibata-cursor-no
      - reg-set-bibata-cursor-nwpen
      - reg-set-bibata-cursor-size-all
      - reg-set-bibata-cursor-size-nesw
      - reg-set-bibata-cursor-size-ns
      - reg-set-bibata-cursor-size-nwse
      - reg-set-bibata-cursor-size-we
      - reg-set-bibata-cursor-up-arrow
      - reg-set-bibata-cursor-wait
      - reg-set-bibata-cursor-precisionhair
      - reg-set-bibata-cursor-grab
      - reg-set-bibata-cursor-grabbing
      - reg-set-bibata-cursor-pin
      - reg-set-bibata-cursor-person
      - reg-set-bibata-cursor-pan
      - reg-set-bibata-cursor-zoom-in
      - reg-set-bibata-cursor-zoom-out
    directives:
      description: Refresh cursor scheme via SystemParametersInfo
    settings:
      GetScript: |
        return @{ Result = "cursor refresh" }
      TestScript: |
        return $false
      SetScript: |
        $CSharpSig = @'
        [DllImport("user32.dll", EntryPoint = "SystemParametersInfo")]
        public static extern bool SystemParametersInfo(
                    uint uiAction,
                    uint uiParam,
                    uint pvParam,
                    uint fWinIni);
        '@
        $CursorRefresh = Add-Type -MemberDefinition $CSharpSig -Name WinAPICall -Namespace SystemParamInfo -PassThru
        $CursorRefresh::SystemParametersInfo(0x0057, 0, $null, 0)

  - resource: xPSDesiredStateConfiguration/xWindowsOptionalFeature
    id: feature-WindowsMediaPlayer
    directives:
      description: Disable Windows Media Player
      securityContext: elevated
    settings:
      id: WindowsMediaPlayer
      state: Disabled
      removefilesondisable: true

