
# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  configurationVersion: 0.2.0
  resources:

    # Use script until Winget supports custom overrides
    # https://github.com/microsoft/winget-cli/issues/3401
    - resource: xPSDesiredStateConfiguration/xScript
      # https://gitforwindows.org/silent-or-unattended-installation.html
      # https://jrsoftware.org/ishelp/index.php?topic=setupcmdline
      id: install-git
      directives:
        description: Install Git for Windows with custom options
      settings:
        GetScript: |
          @{ Result = & winget list --id Git.Git --exact --quiet 2>$null }
        TestScript: |
          $result = & winget list --id Git.Git --exact --quiet 2>$null
          return $LASTEXITCODE -eq 0
        SetScript: |
          $gitInstallPath = Join-Path -Path $env:LOCALAPPDATA -ChildPath "Programs\Git"
          $overrideParams = @(
            '/SP-'
            '/VERYSILENT'
            '/SUPPRESSMSGBOXES'
            '/NORESTART'
            '/NOCANCEL'
            '/CURRENTUSER'
            '/LOG'
            '/Components="gitlfs,scalar"'
            "/DIR=`"$gitInstallPath`""
            '/o:PathOption=BashOnly'
            '/o:SSHOption=ExternalOpenSSH'
            '/o:CURLOption=WinSSL'
            '/o:BashTerminalOption=ConHost'
          ) -join ' '
          winget install Git.Git --source winget --silent --override $overrideParams

    - resource: xPSDesiredStateConfiguration/xScript
      id: path-contains-git
      directives:
        description: Ensure Git is in the PATH for the current user
      dependsOn:
        - install-git
      settings:
        GetScript: |
          $gitInstallPath = Join-Path -Path $env:LOCALAPPDATA -ChildPath "Programs\Git"
          $pathsToAdd = @(
            (Join-Path -Path $gitInstallPath -ChildPath "bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "cmd"),
            (Join-Path -Path $gitInstallPath -ChildPath "mingw64\bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "usr\bin")
          )
          $currentPath = [Environment]::GetEnvironmentVariable('Path', [EnvironmentVariableTarget]::User)
          $splitPath = $currentPath -split ';'
          if (($pathsToAdd | Where-Object { $splitPath -notcontains $_ }).Count -eq 0) {
            return $true
          } else {
            return $false
          }
        TestScript: |
          $gitInstallPath = Join-Path -Path $env:LOCALAPPDATA -ChildPath "Programs\Git"
          $pathsToAdd = @(
            (Join-Path -Path $gitInstallPath -ChildPath "bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "cmd"),
            (Join-Path -Path $gitInstallPath -ChildPath "mingw64\bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "usr\bin")
          )
          $currentPath = [Environment]::GetEnvironmentVariable('Path', [EnvironmentVariableTarget]::User)
          $splitPath = $currentPath -split ';'
          if (($pathsToAdd | Where-Object { $splitPath -notcontains $_ }).Count -eq 0) {
            return $true
          } else {
            return $false
          }
        SetScript: |
          $gitInstallPath = Join-Path -Path $env:LOCALAPPDATA -ChildPath "Programs\Git"
          $pathsToAdd = @(
            (Join-Path -Path $gitInstallPath -ChildPath "bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "cmd"),
            (Join-Path -Path $gitInstallPath -ChildPath "mingw64\bin"),
            (Join-Path -Path $gitInstallPath -ChildPath "usr\bin")
          )
          $currentPath = [Environment]::GetEnvironmentVariable('Path', [EnvironmentVariableTarget]::User)
          $splitPath = $currentPath -split ';'
          $missingPaths = $pathsToAdd | Where-Object { $splitPath -notcontains $_ }
          if ($missingPaths.Count -eq 0) {
            Write-Host 'Git is already in the path.'
          } else {
            $newPath = ($splitPath + $missingPaths) -join ';'
            [Environment]::SetEnvironmentVariable('Path', $newPath, [EnvironmentVariableTarget]::User)
            Write-Host 'Git has been added to the path.'
          }