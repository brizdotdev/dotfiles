$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
- name: GoogleChrome
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Google Chrome
  properties:
    id: Google.Chrome
    source: winget

- name: MozillaFirefox
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Mozilla Firefox
  properties:
    id: Mozilla.Firefox
    source: winget
    scope: user

- name: LibreWolf
  type: Microsoft.WinGet/Package
  metadata:
    description: Install LibreWolf
  properties:
    id: LibreWolf.LibreWolf
    source: winget

# TODO: Browser extensions
# TODO: Browser config
# TODO: Set default browser
