##############################################################################
# Git
##############################################################################

- name: MiseConfigSymlink
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Symlink mise config.toml to dotfiles
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.config\mise\config.toml" = "$env:DOTFILES\common\config\mise\mise.toml"
      }
      New-SymlinkConfig -Config $config

##############################################################################
# Utils
##############################################################################

- name: Poppler
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Poppler (Yazi PDF Preview)
  properties:
    id: oschwartz10612.poppler
    source: winget
    installMode: silent

- name: mise
  type: Microsoft.WinGet/Package
  metadata:
    description: Install mise
  properties:
    id: jdx.mise
    source: winget
    installMode: silent

- name: MiseShimsPath
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Ensure the mise shims directory is in the PATH
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      return Test-EnvPath -Paths @($shimsPath)
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $shimsPath = "$env:LocalAppData\mise\shims"
      Add-EnvPath -Paths @($shimsPath)
