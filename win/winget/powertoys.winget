# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3

resources:
- name: winget_Microsoft.PowerToys
  type: Microsoft.WinGet/Package
  metadata:
    description: "Install Microsoft.PowerToys"
  properties:
    id: "Microsoft.PowerToys"
    source: "winget"

# Docs: https://learn.microsoft.com/en-us/windows/powertoys/dsc-configure/microsoft-dsc

- name: Microsoft.PowerToys/AdvancedPasteSettings-0
  type: Microsoft.PowerToys/AdvancedPasteSettings
  dependsOn:
  - winget_Microsoft.PowerToys
  properties:
    settings:
      version: "1.0"
      properties:
        custom-actions:
          value: []
        IsAIEnabled:
          value: false
        additional-actions:
          transcode:
            transcode-to-mp3:
              isShown: false
              shortcut:
                alt: false
                ctrl: false
                shift: false
                code: 0
                key: ""
                win: false
            transcode-to-mp4:
              isShown: false
              shortcut:
                alt: false
                ctrl: false
                shift: false
                code: 0
                key: ""
                win: false
            isShown: true
          paste-as-file:
            paste-as-txt-file:
              isShown: false
              shortcut:
                alt: false
                ctrl: false
                shift: false
                code: 0
                key: ""
                win: false
            paste-as-png-file:
              isShown: false
              shortcut:
                alt: false
                ctrl: false
                shift: false
                code: 0
                key: ""
                win: false
            isShown: true
            paste-as-html-file:
              isShown: false
              shortcut:
                alt: false
                ctrl: false
                shift: false
                code: 0
                key: ""
                win: false
          image-to-text:
            isShown: false
            shortcut:
              alt: false
              ctrl: false
              shift: false
              code: 0
              key: ""
              win: false
        paste-as-plain-hotkey:
          alt: true
          ctrl: true
          shift: false
          code: 86
          key: ""
          win: true
        EnableClipboardPreview:
          value: true
        ShowCustomPreview:
          value: true
        paste-ai-configuration:
          providers: []
          active-provider-id: ""
        paste-as-json-hotkey:
          alt: false
          ctrl: false
          shift: false
          code: 0
          key: ""
          win: false
        AutoCopySelectionForCustomActionHotkey:
          value: false
        CloseAfterLosingFocus:
          value: false
        advanced-paste-ui-hotkey:
          alt: false
          ctrl: false
          shift: true
          code: 86
          key: ""
          win: true
        paste-as-markdown-hotkey:
          alt: false
          ctrl: false
          shift: false
          code: 0
          key: ""
          win: false
      name: "AdvancedPaste"
- name: Microsoft.PowerToys/AlwaysOnTopSettings-0
  type: Microsoft.PowerToys/AlwaysOnTopSettings
  dependsOn:
  - winget_Microsoft.PowerToys
  properties:
    settings:
      version: "0.0.1"
      properties:
        frame-accent-color:
          value: false
        show-in-system-menu:
          value: false
        do-not-activate-on-game-mode:
          value: true
        round-corners-enabled:
          value: true
        frame-opacity:
          value: 100
        frame-thickness:
          value: 3
        excluded-apps:
          value: ""
        frame-color:
          value: "#FFC300FF"
        sound-enabled:
          value: true
        frame-enabled:
          value: true
        hotkey:
          value:
            alt: false
            ctrl: false
            shift: true
            code: 90
            key: ""
            win: true
        decrease-opacity-hotkey:
          value:
            alt: false
            ctrl: true
            shift: false
            code: 189
            key: ""
            win: true
        increase-opacity-hotkey:
          value:
            alt: false
            ctrl: true
            shift: false
            code: 187
            key: ""
            win: true
      name: "AlwaysOnTop"
- name: Microsoft.PowerToys/AppSettings-0
  type: Microsoft.PowerToys/AppSettings
  dependsOn:
  - winget_Microsoft.PowerToys
  properties:
    settings:
      action_name: ""
      show_tray_icon: true
      startup: true
      show_theme_adaptive_tray_icon: false
      powertoys_version: "v0.98.1"
      system_theme: "dark"
      is_elevated: true
      quick_access_shortcut:
        alt: false
        ctrl: false
        shift: false
        code: 0
        key: ""
        win: false
      is_admin: true
      enabled:
        Hosts: false
        File Explorer Preview: true
        QuickAccent: false
        PowerRename: false
        LightSwitch: true
        MousePointerCrosshairs: false
        ZoomIt: true
        AlwaysOnTop: true
        Workspaces: true
        NewPlus: false
        ColorPicker: true
        FancyZones: false
        AdvancedPaste: true
        PowerToys Run: true
        EnvironmentVariables: false
        Awake: true
        Measure Tool: true
        Keyboard Manager: true
        File Locksmith: true
        TextExtractor: true
        MouseHighlighter: false
        PowerDisplay: false
        CmdPal: false
        CmdNotFound: false
        Peek: true
        MouseWithoutBorders: false
        RegistryPreview: false
        FindMyMouse: false
        CropAndLock: true
        MouseJump: false
        CursorWrap: false
        Shortcut Guide: true
        Image Resizer: false
      ignored_conflict_properties:
        ignored_shortcuts: []
      show_whats_new_after_updates: true
      run_elevated: false
      enable_experimentation: true
      enable_warnings_elevated_apps: false
      show_new_updates_toast_notification: true
      theme: "system"
      dashboard_sort_order: 0
      download_updates_automatically: true
      enable_quick_access: true
- name: Microsoft.PowerToys/AwakeSettings-0
  type: Microsoft.PowerToys/AwakeSettings
  dependsOn:
  - winget_Microsoft.PowerToys
  properties:
    settings:
      version: "1.0"
      properties:
        expirationDateTime: "2023-05-05T10:39:34.9242148+10:00"
        keepDisplayOn: true
        intervalMinutes: 0
        mode: 0
        customTrayTimes: {}
        intervalHours: 2
      name: "Awake"
- name: Microsoft.PowerToys/ColorPickerSettings-0
  type: Microsoft.PowerToys/ColorPickerSettings
  dependsOn:
  - winget_Microsoft.PowerToys
  properties:
    settings:
      version: "2.1"
      properties:
        ActivationShortcut:
          alt: false
          ctrl: false
          shift: true
          code: 67
          key: ""
          win: true
        copiedcolorrepresentation: "HEX"
        middleclickaction: 1
        primaryclickaction: 0
        showcolorname:
          value: true
        DefaultActivationShortcut:
          alt: false
          ctrl: false
          shift: true
          code: 67
          key: ""
          win: true
        visiblecolorformats:
          Oklch:
            Key: false
            Value: "oklch(%Lo, %Oc, %Oh)"
          HSI:
            Key: false
            Value: "hsi(%Hu, %Si%, %In%)"
          HEX Int:
            Key: false
            Value: "0xFF%ReX%GrX%BlX"
          HEX:
            Key: true
            Value: "%Rex%Grx%Blx"
          Decimal:
            Key: false
            Value: "%Dv"
          CIEXYZ:
            Key: false
            Value: "XYZ(%Xv, %Yv, %Zv)"
          HSB:
            Key: false
            Value: "hsb(%Hu, %Sb%, %Br%)"
          CMYK:
            Key: true
            Value: "cmyk(%Cy%, %Ma%, %Ye%, %Bk%)"
          Oklab:
            Key: false
            Value: "oklab(%Lo, %Oa, %Ob)"
          HWB:
            Key: false
            Value: "hwb(%Hu, %Wh%, %Bn%)"
          HSV:
            Key: true
            Value: "hsv(%Hu, %Sb%, %Va%)"
          RGB:
            Key: true
            Value: "rgb(%Re, %Gr, %Bl)"
          NCol:
            Key: false
            Value: "%Hn, %Wh%, %Bn%"
          HSL:
            Key: true
            Value: "hsl(%Hu, %Sl%, %Ll%)"
          VEC4:
            Key: false
            Value: "(%Reff, %Grff, %Blff, 1f)"
          CIELAB:
            Key: false
            Value: "CIELab(%Lc, %Ca, %Cb)"
        secondaryclickaction: 2
        activationaction: 1
        colorhistory:
        - "255|0|0|0"
        - "255|39|39|39"
        - "255|235|117|71"
        - "255|235|58|52"
        - "255|20|20|20"
        - "255|32|33|36"
        - "255|141|89|255"
        - "255|130|96|204"
        - "255|163|121|255"
        - "255|134|112|235"
        - "255|91|76|159"
        - "255|97|84|164"
        - "255|13|53|98"
        - "255|255|126|167"
        - "255|206|102|135"
        - "255|5|4|35"
        - "255|28|30|38"
        - "255|10|0|0"
        - "255|120|190|32"
        - "255|61|71|86"
        - "255|6|182|212"
        - "255|40|168|234"
        - "255|68|111|194"
        - "255|22|26|34"
        - "255|34|36|44"
        - "255|45|47|62"
        - "255|30|32|32"
        - "255|18|20|24"
        colorhistorylimit: 20
        changecursor:
          value: false
      name: "ColorPicker"
