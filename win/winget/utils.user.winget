##############################################################################
# Utilities & media
# Installs general-purpose utilities, media players, and codec extensions
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: PathContains7Zip
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Ensure 7-Zip is in the path
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $pathsToAdd = @('C:\Program Files\7-Zip')
      return Test-EnvPath -Paths $pathsToAdd
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $pathsToAdd = @('C:\Program Files\7-Zip')
      Add-EnvPath -Paths $pathsToAdd

- name: LocalSend
  type: Microsoft.WinGet/Package
  metadata:
    description: Install LocalSend
  properties:
    id: LocalSend.LocalSend
    source: winget
    installMode: silent

- name: Bitwarden
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Bitwarden
  properties:
    id: Bitwarden.Bitwarden
    source: winget
    installMode: silent

- name: WindowsClock
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Windows Clock
  properties:
    id: 9WZDNCRFJ3PR
    source: msstore
    installMode: silent
    acceptAgreements: true

- name: WindowsCalculator
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Windows Calculator
  properties:
    id: 9WZDNCRFHVN5
    source: msstore
    installMode: silent
    acceptAgreements: true

- name: WindowsCamera
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Windows Camera
  properties:
    id: 9WZDNCRFJBBG
    source: msstore
    installMode: silent
    acceptAgreements: true

