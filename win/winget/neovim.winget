##############################################################################
# Neovim
# Installs Neovim, sets it as EDITOR, and symlinks Neovim/vim configs
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# Neovim
##############################################################################

- name: Neovim
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Neovim
  properties:
    id: Neovim.Neovim
    source: winget
    installMode: silent

- name: EditorEnvVar
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Neovim is set as EDITOR
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Test-EnvVar -Name "EDITOR" -Value "nvim"
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      Add-EnvVar -Name "EDITOR" -Value "nvim"

- name: NvimSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure Neovim is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LocalAppData\nvim" = "$env:DOTFILES\common\config\nvim"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:LocalAppData\nvim" = "$env:DOTFILES\common\config\nvim"
      }
      New-SymlinkConfig -Config $config

- name: VimrcSettings
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Ensure vimrc is configured
  properties:
    testScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.vimrc" = "$env:DOTFILES\common\config\vim\.vimrc"
      }
      return Test-SymlinkConfig -Config $config
    setScript: |
      . "${WinGetConfigRoot}\..\scripts\Utils.ps1"
      $config = @{
        "$env:USERPROFILE\.vimrc" = "$env:DOTFILES\common\config\vim\.vimrc"
      }
      New-SymlinkConfig -Config $config
