##############################################################################
# Utilities & media
# Installs general-purpose utilities, media players, and codec extensions
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

##############################################################################
# Utilities
##############################################################################

- name: Everything
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Everything
    securityContext: elevated
  properties:
    id: voidtools.Everything
    source: winget
    installMode: silent

- name: 7Zip
  type: Microsoft.WinGet/Package
  metadata:
    description: Install 7-Zip
    securityContext: elevated
  properties:
    id: 7zip.7zip
    source: winget
    installMode: silent

- name: gsudo
  type: Microsoft.WinGet/Package
  metadata:
    description: Install gsudo
    securityContext: elevated
  properties:
    id: gerardog.gsudo
    source: winget
    installMode: silent

- name: OpenSSH
  type: Microsoft.WinGet/Package
  metadata:
    description: Install OpenSSH
    securityContext: elevated
  properties:
    id: Microsoft.OpenSSH.Preview
    source: winget
    installMode: silent

- name: mpv
  type: Microsoft.WinGet/Package
  metadata:
    description: Install mpv
    securityContext: elevated
  properties:
    id: shinchiro.mpv
    source: winget
    installMode: silent

- name: VLC
  type: Microsoft.WinGet/Package
  metadata:
    description: Install VLC
    securityContext: elevated
  properties:
    id: VideoLAN.VLC
    source: winget
    installMode: silent
