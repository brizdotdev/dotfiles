# System
- name: RealTimeIsUniversal
  type: Microsoft.Windows/Registry
  metadata:
    description: Set hardware clock to UTC (dual boot)
    securityContext: elevated
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation
    valueName: RealTimeIsUniversal
    valueData:
      QWord: 1
    _exist: true

- name: VerboseBSOD
  type: Microsoft.Windows/Registry
  metadata:
    description: Show detailed information on blue screen
    securityContext: elevated
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\CrashControl
    valueName: DisplayParameters
    valueData:
      DWord: 1
    _exist: true

- name: BSODNoEmoticon
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable sad-face emoticon on blue screen
    securityContext: elevated
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\CrashControl
    valueName: DisableEmoticon
    valueData:
      DWord: 1
    _exist: true

# Recovery
- name: PointInTimeRestore
  type: Microsoft.Windows/Registry
  metadata:
    description: Enable point-in-time restore
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\Recovery\PITR\Settings
    valueName: Active_UX
    valueData:
      DWord: 1
    _exist: true

- name: PointInTimeRestoreMaxDiskUsage
  type: Microsoft.Windows/Registry
  metadata:
    description: Set point-in-time restore max disk usage to 10 GB
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\Recovery\PITR\Settings
    valueName: MaxGlobalSize_UX
    valueData:
      DWord: 10240
    _exist: true

# Block OEM software auto-install via Windows Update drivers (e.g. Razer Synapse)
- name: NoDriverSearchWindowsUpdate
  type: Microsoft.Windows/Registry
  metadata:
    description: Do not search Windows Update for device drivers
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\DriverSearching
    valueName: SearchOrderConfig
    valueData:
      DWord: 0
    _exist: true

- name: DisableDeviceCoInstallers
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable device co-installers (blocks OEM software auto-install)
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Device Installer
    valueName: DisableCoInstallers
    valueData:
      DWord: 1
    _exist: true
