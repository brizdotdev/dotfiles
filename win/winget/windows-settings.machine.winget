##############################################################################
# Settings
# Windows general settings and options
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: ShowLnkExtension
  type: Microsoft.Windows/Registry
  metadata:
    description: Show .lnk file extension on shortcut files
    securityContext: elevated
  properties:
    keyPath: HKEY_CLASSES_ROOT\lnkfile
    valueName: NeverShowExt
    _exist: false

- name: DisableAutorunAllDrives
  type: Microsoft.Windows/Registry
  metadata:
    description: Block autorun on all drive types (policy)
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer
    valueName: NoDriveTypeAutoRun
    valueData:
      DWord: 255
    _exist: true

# Add common folders back to 'This PC' (adapted from Win11Debloat Add_All_Folders_Under_This_PC.reg)
- name: AddFoldersToThisPC
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Add Desktop, Documents, Downloads, Music, Pictures and Videos folders back to 'This PC' in File Explorer
    securityContext: elevated
  properties:
    testScript: |
      $guids = @(
        '{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}',
        '{d3162b92-9365-467a-956b-92703aca08af}',
        '{088e3905-0323-4b02-9826-5d99428e115f}',
        '{3dfdf296-dbec-4fb4-81d1-6a3438bcf4de}',
        '{1CF1260C-4DD0-4ebb-811F-33C572699FDE}',
        '{24ad3ad4-a569-4530-98e1-ab02f9417aa8}',
        '{f86fa3ab-70d2-4fc7-9c99-fcbf05467f3a}'
      )
      $base = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\MyComputer\NameSpace'
      foreach ($guid in $guids) {
        $path = Join-Path $base $guid
        if (-not (Test-Path -LiteralPath $path)) { return $false }
        $hideIfEnabled = (Get-ItemProperty -LiteralPath $path -Name HideIfEnabled -ErrorAction SilentlyContinue).HideIfEnabled
        if ($null -ne $hideIfEnabled) { return $false }
        $hiddenByDefault = (Get-ItemProperty -LiteralPath $path -Name HiddenByDefault -ErrorAction SilentlyContinue).HiddenByDefault
        if ($hiddenByDefault -ne 0) { return $false }
      }
      return $true
    setScript: |
      $guids = @(
        '{B4BFCC3A-DB2C-424C-B029-7FE99A87C641}',
        '{d3162b92-9365-467a-956b-92703aca08af}',
        '{088e3905-0323-4b02-9826-5d99428e115f}',
        '{3dfdf296-dbec-4fb4-81d1-6a3438bcf4de}',
        '{1CF1260C-4DD0-4ebb-811F-33C572699FDE}',
        '{24ad3ad4-a569-4530-98e1-ab02f9417aa8}',
        '{f86fa3ab-70d2-4fc7-9c99-fcbf05467f3a}'
      )
      $base = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\MyComputer\NameSpace'
      foreach ($guid in $guids) {
        $path = Join-Path $base $guid
        if (-not (Test-Path -LiteralPath $path)) {
          New-Item -Path $path -Force | Out-Null
        }
        Remove-ItemProperty -LiteralPath $path -Name HideIfEnabled -ErrorAction SilentlyContinue
        Set-ItemProperty -LiteralPath $path -Name HiddenByDefault -Value 0 -Type DWord
      }

# Windows Update
- name: NoAutoRestart
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic restart after updates
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate
    valueName: SetActiveHours
    valueData:
      DWord: 0
    _exist: true

- name: AuOptions
  type: Microsoft.Windows/Registry
  metadata:
    description: Set AU to auto-download but notify before installing
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
    valueName: AUOptions
    valueData:
      DWord: 4
    _exist: true

- name: NoAutoRebootLoggedOn
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic reboot when users are logged on
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
    valueName: NoAutoRebootWithLoggedOnUsers
    valueData:
      DWord: 1
    _exist: true

- name: NoExpeditedReboot
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable automatic reboot after update install
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: IsExpedited
    valueData:
      DWord: 0
    _exist: true

- name: NoRestartNotifications
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable restart required notifications
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: RestartNotificationsAllowed2
    valueData:
      DWord: 0
    _exist: true

- name: NoMeteredUpdates
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable auto updates over metered connections
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: AllowAutoWindowsUpdateDownloadOverMeteredNetwork
    valueData:
      DWord: 0
    _exist: true

- name: ReceiveOtherMicrosoftUpdates
  type: Microsoft.Windows/Registry
  metadata:
    description: Receive updates for other Microsoft products (Office, Visual Studio, etc.)
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings
    valueName: AllowMUUpdateService
    valueData:
      DWord: 1
    _exist: true

- name: RegisterMicrosoftUpdateService
  type: Microsoft.DSC.Transitional/PowerShellScript
  metadata:
    description: Opt-in to Microsoft Update service via WUA COM API (registers service so AllowMUUpdateService toggle takes effect)
    securityContext: elevated
  properties:
    testScript: |
      try {
        $manager = New-Object -ComObject Microsoft.Update.ServiceManager
        $service = $manager.Services | Where-Object { $_.ServiceID -eq '7971f918-a847-4430-9279-4a52d1efe18d' }
        return ($null -ne $service)
      } catch {
        return $false
      }
    setScript: |
      $manager = New-Object -ComObject Microsoft.Update.ServiceManager
      $manager.ClientApplicationID = 'opencode-dotfiles'
      $null = $manager.AddService2('7971f918-a847-4430-9279-4a52d1efe18d', 7, '')

# Microsoft Edge
- name: EdgeHideFirstRun
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Microsoft Edge first run experience
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Edge
    valueName: HideFirstRunExperience
    valueData:
      DWord: 1
    _exist: true

- name: EdgeDisableBackgroundMode
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Microsoft Edge background mode
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Edge\Recommended
    valueName: BackgroundModeEnabled
    valueData:
      DWord: 0
    _exist: true

- name: EdgeDisableStartupBoost
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Microsoft Edge startup boost
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Edge\Recommended
    valueName: StartupBoostEnabled
    valueData:
      DWord: 0
    _exist: true

# Edge debloat (adapted from winutil WPFTweaksEdgeDebloat)
- name: EdgeNoDesktopShortcut
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Edge desktop shortcut creation on update
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate
    valueName: CreateDesktopShortcutDefault
    valueData:
      DWord: 0
    _exist: true

- name: EdgeNoPersonalizationReporting
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Edge personalization/advertising reporting
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Edge
    valueName: PersonalizationReportingEnabled
    valueData:
      DWord: 0
    _exist: true

- name: EdgeBlockCopilotExtension
  type: Microsoft.Windows/Registry
  metadata:
    description: Block install of the Edge Copilot extension
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallBlocklist
    valueName: "1"
    valueData:
      String: ofefcgjbeghpigppfmkologfjadafddi
    _exist: true

- name: EdgeNoRecommendations
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Edge recommendations and promotional content
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Edge
    valueName: ShowRecommendationsEnabled
    valueData:
      DWord: 0
    _exist: true

- name: EdgeNoUserFeedback
