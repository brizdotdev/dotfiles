# Colors
- name: TitlebarColor
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable theme colors on titlebar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\DWM
    valueName: ColorPrevalence
    valueData:
      DWord: 0
    _exist: true

- name: NoAccentColor
  type: Microsoft.Windows/Registry
  metadata:
    description: Turn off accent color on Start and taskbar
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize
    valueName: ColorPrevalence
    valueData:
      DWord: 0
    _exist: true

