- name: RefreshCursor
  type: Microsoft.DSC.Transitional/RunCommandOnSet
  metadata:
    description: Refresh cursor scheme via SystemParametersInfo
  properties:
    executable: pwsh
    arguments:
      "0": -NoProfile
      "1": -NoLogo
      "2": -Command
      "3": >-
        $CSharpSig = '[DllImport("user32.dll", EntryPoint = "SystemParametersInfo")] public static extern bool SystemParametersInfo( uint uiAction, uint uiParam, uint pvParam, uint fWinIni);'
        $CursorRefresh = Add-Type -MemberDefinition $CSharpSig -Name WinAPICall -Namespace SystemParamInfo -PassThru
        $CursorRefresh::SystemParametersInfo(0x0057, 0, $null, 0)
      treatAsArray: true
