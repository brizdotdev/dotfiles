- name: SetBibataCursorPerson
  type: Microsoft.Windows/Registry
  metadata:
    description: Set Bibata cursor Person
  properties:
    keyPath: HKCU\Control Panel\Cursors
    valueName: Person
    valueData:
      String: "C:\\WINDOWS\\Cursors\\Bibata-Modern-Classic-Small Cursors\\Person.cur"
    _exist: true

