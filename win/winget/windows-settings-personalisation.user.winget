# Animations
- name: AnimateWindows
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable window animations when minimizing and maximizing
  properties:
    keyPath: HKCU\Control Panel\Desktop\WindowMetrics
    valueName: MinAnimate
    valueData:
      String: "0"
    _exist: true

- name: DisableAnimations
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable UI animations via UserPreferencesMask
  properties:
    keyPath: HKCU\Control Panel\Desktop
    valueName: UserPreferencesMask
    valueData:
      Binary:
        - 144
        - 18
        - 7
        - 128
        - 16
        - 0
        - 0
        - 0
    _exist: true

- name: MenuShowDelay
  type: Microsoft.Windows/Registry
  metadata:
    description: Faster menu show delay (200ms)
  properties:
    keyPath: HKCU\Control Panel\Desktop
    valueName: MenuShowDelay
    valueData:
      String: "200"
    _exist: true

# Visual effects - best performance extras (adapted from winutil WPFTweaksDisplay)
- name: NoDragFullWindows
  type: Microsoft.Windows/Registry
  metadata:
    description: Do not show window contents while dragging
  properties:
    keyPath: HKCU\Control Panel\Desktop
    valueName: DragFullWindows
    valueData:
      String: "0"
    _exist: true

- name: KeyboardDelayFast
  type: Microsoft.Windows/Registry
  metadata:
    description: Shortest keyboard repeat delay
  properties:
    keyPath: HKCU\Control Panel\Keyboard
    valueName: KeyboardDelay
    valueData:
      String: "0"
    _exist: true

- name: NoListviewAlphaSelect
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable translucent selection rectangle in Explorer
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ListviewAlphaSelect
    valueData:
      DWord: 0
    _exist: true

- name: NoListviewShadow
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable drop shadows for icon labels on desktop
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ListviewShadow
    valueData:
      DWord: 0
    _exist: true

- name: NoTaskbarAnimations
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable taskbar animations
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarAnimations
    valueData:
      DWord: 0
    _exist: true

- name: VisualFXCustom
  type: Microsoft.Windows/Registry
  metadata:
    description: Set visual effects to custom (required for individual effect toggles)
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects
    valueName: VisualFXSetting
    valueData:
      DWord: 3
    _exist: true

- name: NoAeroPeek
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Aero Peek desktop preview
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\DWM
    valueName: EnableAeroPeek
    valueData:
      DWord: 0
    _exist: true

- name: SetBibataCursorSchemeName
  type: Microsoft.Windows/Registry
  metadata:
    description: Set Bibata cursor scheme name (default value)
  properties:
    keyPath: HKCU\Control Panel\Cursors
    valueName: "\"\""
    valueData:
      String: "Bibata-Modern-Classic-Small Cursors"
    _exist: true

- name: SetBibataCursorSchemeSource
  type: Microsoft.Windows/Registry
  metadata:
    description: Set Bibata cursor scheme source
  properties:
    keyPath: HKCU\Control Panel\Cursors
    valueName: "\"Scheme Source\""
    valueData:
      DWord: 1
    _exist: true

- name: SetBibataCursorBaseSize
  type: Microsoft.Windows/Registry
  metadata:
    description: Set Bibata cursor base size
  properties:
    keyPath: HKCU\Control Panel\Cursors
    valueName: CursorBaseSize
    valueData:
      DWord: 32
    _exist: true

- name: SetBibataCursorContactVisualization
