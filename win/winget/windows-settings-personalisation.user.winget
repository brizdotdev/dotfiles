
##############################################################################
# Personalization
# Settings related to looks and appearance
##############################################################################

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

# https://github.com/microsoft/WindowsDeveloperConfig/blob/0cd8dda905529e8408747fb3e01ea1382cbd335f/windows-dev-config/dev-config.winget#L223-L247
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: DarkTheme
  properties:
    testScript: |
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'
      $apps   = Get-ItemPropertyValue $regPath -Name AppsUseLightTheme    -EA SilentlyContinue
      $system = Get-ItemPropertyValue $regPath -Name SystemUsesLightTheme -EA SilentlyContinue
      return ($apps -eq 0 -and $system -eq 0)
    setScript: |
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'
      Set-ItemProperty -Path $regPath -Name "AppsUseLightTheme" -Value 0
      Set-ItemProperty -Path $regPath -Name "SystemUsesLightTheme" -Value 0
  metadata:
    description: Sets dark theme

# Start Menu

- name: StartVisiblePlaces
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide recommended places in Start Menu
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Start
    valueName: VisiblePlaces
    valueData:
      Binary:
        - 0

- name: StartDisplayIconsAsGrid
  type: Microsoft.Windows/Registry
  metadata:
    description: Display icons as grid in Start Menu (hint; StartMenuExperienceHost may overwrite)
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Start
    valueName: AllAppsViewMode
    valueData:
      DWord: 1

# Only honored on builds >= 26300 (25H2 Insider); inert on earlier builds
- name: StartShowPinnedSection
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide pinned section in Start Menu
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Start
    valueName: ShowPinnedSection
    valueData:
      DWord: 0

- name: StartNoRecentlyAdded
  type: Microsoft.Windows/Registry
  metadata:
    description: "Start: Hide recently added apps from Start"
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Start
    valueName: ShowRecentList
    valueData:
      DWord: 0
    _exist: true

- name: HideRecentlyAddedAppsPolicy
  type: Microsoft.Windows/Registry
  metadata:
    description: "Start: Hide recently added apps (policy)"
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\Explorer
    valueName: NoStartMenuRecentlyInstalledApps
    valueData:
      DWord: 1
    _exist: true

- name: HideMostUsedApps
  type: Microsoft.Windows/Registry
  metadata:
    description: "Start: Hide most used apps list (policy)"
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\Explorer
    valueName: NoStartMenuMFUprogramsList
    valueData:
      DWord: 1
    _exist: true

- name: HideFrequentListWin11
  type: Microsoft.Windows/Registry
  metadata:
    description: "Start: Hide most used apps list (Win11)"
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Start
    valueName: ShowFrequentList
    valueData:
      DWord: 0
    _exist: true

- name: ClassicContextMenu
  type: Microsoft.Windows/Registry
  metadata:
    description: Restore classic right-click context menu in Windows 11
  properties:
    keyPath: HKCU\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32
    valueName: "InprocServer32"
    valueData:
      String: ""
    _exist: true

- name: HideDesktopIcons
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide desktop icons
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer
    valueName: NoDesktop
    valueData:
      DWord: 1
    _exist: true

# Taskbar
- name: TaskbarAlignmentCenter
  type: Microsoft.Windows/Registry
  metadata:
    description: Center taskbar alignment
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarAl
    valueData:
      DWord: 1
    _exist: true

- name: HideSearch
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Search button from taskbar
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Search
    valueName: SearchboxTaskbarMode
    valueData:
      DWord: 0
    _exist: true

- name: HideTaskView
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Task View button from taskbar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ShowTaskViewButton
    valueData:
      DWord: 0
    _exist: true

- name: HideWidgets
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Widgets button from taskbar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarDa
    valueData:
      DWord: 0
    _exist: true

- name: HideChat
  type: Microsoft.Windows/Registry
  metadata:
    description: Hide Chat button from taskbar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarMn
    valueData:
      DWord: 0
    _exist: true

- name: TaskbarEndTask
  type: Microsoft.Windows/Registry
  metadata:
    description: Show End Task button in taskbar context menu
  properties:
    keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings
    valueName: TaskbarEndTask
    valueData:
      DWord: 1
    _exist: true

- name: LastActiveClick
  type: Microsoft.Windows/Registry
  metadata:
    description: Taskbar icon click opens last active window
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: LastActiveClick
    valueData:
      DWord: 1
    _exist: true

