##############################################################################
# Gaming
# Installs gaming apps (Discord, Steam, GOG Galaxy) and applies gaming/
# performance registry tweaks (Game Mode, Game DVR, GPU/CPU scheduling)
##############################################################################
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:

- name: DiscordStartup
  type: Microsoft.Windows/Registry
  metadata:
    description: Ensure Discord does not start on login
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows\CurrentVersion\Run
    valueName: Discord
    _exist: false

# ============================================================================
# Gaming & performance (HKLM)
# Adapted from autounattend.xml Winhancements.ps1 (Gaming & Performance Settings)
# ============================================================================

- name: Win32PrioritySeparation
  type: Microsoft.Windows/Registry
  metadata:
    description: Give foreground apps longer CPU quantums for responsiveness
    securityContext: elevated
  properties:
    keyPath: HKLM\System\CurrentControlSet\Control\PriorityControl
    valueName: Win32PrioritySeparation
    valueData:
      DWord: 38
    _exist: true

- name: SystemResponsiveness
  type: Microsoft.Windows/Registry
  metadata:
    description: Reduce background CPU reservation for active game/multimedia
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile
    valueName: SystemResponsiveness
    valueData:
      DWord: 10
    _exist: true

- name: NetworkThrottlingIndex
  type: Microsoft.Windows/Registry
  metadata:
    description: Keep network throttling at default 10 (better DPC latency for gaming)
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile
    valueName: NetworkThrottlingIndex
    valueData:
      DWord: 10
    _exist: true

- name: GameTaskPriority
  type: Microsoft.Windows/Registry
  metadata:
    description: Give games higher CPU scheduling priority
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games
    valueName: Priority
    valueData:
      DWord: 6
    _exist: true

- name: GameTaskScheduling
  type: Microsoft.Windows/Registry
  metadata:
    description: Assign high-priority scheduling category to games
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games
    valueName: Scheduling Category
    valueData:
      String: "High"
    _exist: true

- name: GameTaskGpuPriority
  type: Microsoft.Windows/Registry
  metadata:
    description: Give games higher GPU scheduling priority
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games
    valueName: GPU Priority
    valueData:
      DWord: 8
    _exist: true

- name: HwSchMode
  type: Microsoft.Windows/Registry
  metadata:
    description: Enable hardware-accelerated GPU scheduling (reduces latency on supported drivers)
    securityContext: elevated
  properties:
    keyPath: HKLM\System\CurrentControlSet\Control\GraphicsDrivers
    valueName: HwSchMode
    valueData:
      DWord: 2
    _exist: true

- name: NvidiaGR535
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable legacy NVIDIA image-sharpening flag (modern drivers use Control Panel)
    securityContext: elevated
  properties:
    keyPath: HKLM\Software\NVIDIA Corporation\Global\FTS
    valueName: EnableGR535
    valueData:
      DWord: 0
    _exist: true

- name: AllowGameDVRPolicy
  type: Microsoft.Windows/Registry
  metadata:
    description: Disable Game DVR via machine-wide policy
    securityContext: elevated
  properties:
    keyPath: HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR
    valueName: AllowGameDVR
    valueData:
      DWord: 0
    _exist: true
