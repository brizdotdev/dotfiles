$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
##############################################################################
# Utilities
##############################################################################

- name: Everything
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Everything
  properties:
    id: voidtools.Everything
    source: winget

- name: 7Zip
  type: Microsoft.WinGet/Package
  metadata:
    description: Install 7-Zip
  properties:
    id: 7zip.7zip
    source: winget

- name: PathContains7Zip
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
  - 7Zip
  metadata:
    description: Ensure 7-Zip is in the path
  properties:
    getScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $pathsToAdd = @('C:\Program Files\7-Zip')
      return Test-EnvPath -Paths $pathsToAdd
    testScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $pathsToAdd = @('C:\Program Files\7-Zip')
      return Test-EnvPath -Paths $pathsToAdd
    setScript: |
      . "${WinGetConfigRoot}\..\Utils.ps1"
      $pathsToAdd = @('C:\Program Files\7-Zip')
      Add-EnvPath -Paths $pathsToAdd

- name: gsudo
  type: Microsoft.WinGet/Package
  metadata:
    description: Install gsudo
  properties:
    id: gerardog.gsudo
    source: winget

